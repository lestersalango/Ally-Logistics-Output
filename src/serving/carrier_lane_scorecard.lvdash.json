{
  "datasets": [
    {
      "name": "ds_scorecard",
      "displayName": "Carrier lane scorecard",
      "queryLines": [
        "SELECT g.carrier_dot,\n",
        "       coalesce(g.legal_name, concat('Unverified DOT ', g.carrier_dot)) AS carrier,\n",
        "       coalesce(c.authority_status, 'NOT IN FMCSA') AS authority_status,\n",
        "       c.status_date AS authority_status_date,\n",
        "       g.origin_state, g.dest_state,\n",
        "       concat(g.origin_state, ' → ', g.dest_state) AS lane,\n",
        "       g.load_count, g.total_revenue, g.total_carrier_cost, g.gross_margin, g.margin_pct,\n",
        "       g.unauthorized_load_count, g.unverified_load_count,\n",
        "       CASE WHEN g.unverified_load_count > 0 THEN 'Unverified carrier'\n",
        "            WHEN g.unauthorized_load_count > 0 THEN 'Has unauthorized loads'\n",
        "            ELSE 'Authorized' END AS compliance\n",
        "FROM gold_carrier_lane_scorecard g\n",
        "LEFT JOIN silver_fmcsa_carriers c ON g.carrier_dot = c.dot_number\n"
      ],
      "columns": [
        {
          "displayName": "Loads",
          "description": "Delivered loads picked up in October 2026 (Eastern)",
          "expression": "SUM(`load_count`)"
        },
        {
          "displayName": "Revenue",
          "description": "Customer rate + accessorials",
          "expression": "SUM(`total_revenue`)"
        },
        {
          "displayName": "Carrier Cost",
          "description": "Amount paid to carriers",
          "expression": "SUM(`total_carrier_cost`)"
        },
        {
          "displayName": "Gross Margin",
          "description": "Revenue - carrier cost",
          "expression": "SUM(`gross_margin`)"
        },
        {
          "displayName": "Margin %",
          "description": "Gross margin / revenue (ratio of sums)",
          "expression": "SUM(`gross_margin`) / SUM(`total_revenue`)"
        },
        {
          "displayName": "Unauthorized Loads",
          "description": "Hauled while the carrier's REVOKED/INACTIVE status was already in effect",
          "expression": "SUM(`unauthorized_load_count`)"
        },
        {
          "displayName": "Unverified Loads",
          "description": "Carrier DOT not found in the FMCSA census",
          "expression": "SUM(`unverified_load_count`)"
        }
      ]
    },
    {
      "name": "ds_unauthorized",
      "displayName": "Carrier lanes with unauthorized loads",
      "queryLines": [
        "SELECT g.carrier_dot,\n",
        "       coalesce(g.legal_name, concat('Unverified DOT ', g.carrier_dot)) AS carrier,\n",
        "       coalesce(c.authority_status, 'NOT IN FMCSA') AS authority_status,\n",
        "       c.status_date AS authority_status_date,\n",
        "       g.origin_state, g.dest_state,\n",
        "       concat(g.origin_state, ' → ', g.dest_state) AS lane,\n",
        "       g.load_count, g.total_revenue, g.total_carrier_cost, g.gross_margin, g.margin_pct,\n",
        "       g.unauthorized_load_count, g.unverified_load_count,\n",
        "       CASE WHEN g.unverified_load_count > 0 THEN 'Unverified carrier'\n",
        "            WHEN g.unauthorized_load_count > 0 THEN 'Has unauthorized loads'\n",
        "            ELSE 'Authorized' END AS compliance\n",
        "FROM gold_carrier_lane_scorecard g\n",
        "LEFT JOIN silver_fmcsa_carriers c ON g.carrier_dot = c.dot_number\n",
        "WHERE g.unauthorized_load_count > 0\n"
      ]
    }
  ],
